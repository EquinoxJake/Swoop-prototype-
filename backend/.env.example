# Copy to backend/.env and fill in. Never commit the real .env.

# --- Required ---
MONGO_URL=mongodb://localhost:27017
DB_NAME=swoop
JWT_SECRET=change-me-to-a-long-random-string

# Folder for parking photos (default: backend/uploads). Back it up.
UPLOAD_DIR=

# --- Google sign-in (Google Cloud Console → Credentials → OAuth client IDs) ---
# Comma-separated: web, iOS and Android client IDs
GOOGLE_CLIENT_IDS=

# --- Admins ---
# Emails allowed to charge the $15 improper-parking fee from the API
ADMIN_EMAILS=

# --- Parking photo AI check (console.anthropic.com → API keys) ---
# Leave empty to skip the AI; every photo is then marked for a human check.
ANTHROPIC_API_KEY=
PARKING_AI_MODEL=claude-opus-5-5

# --- Discord bot (discord.com/developers/applications) ---
DISCORD_BOT_TOKEN=
DISCORD_PUBLIC_KEY=
# Your Discord user ID(s), comma-separated (Settings → Advanced → Developer Mode, then right-click your name → Copy User ID)
DISCORD_ADMIN_USER_IDS=
