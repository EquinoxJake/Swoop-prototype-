{
  "expo": {
    "name": "Swoop",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "swoop",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.scootpaygo.pume99",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Find nearby scooters on the map",
        "NSCameraUsageDescription": "Scan the scooter QR code to unlock",
        "NSBluetoothAlwaysUsageDescription": "Connect to your scooter to unlock",
        "NSBluetoothPeripheralUsageDescription": "Connect to your scooter to unlock"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#2E7BFF"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.emergent.scootpaygo.pume99",
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Scan scooter QR codes to unlock rides"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Find nearby scooters on the map"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#2E7BFF"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
